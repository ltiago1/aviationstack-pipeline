# ─── Environment ──────────────────────────────────────────────────────────────
ENV=development           # development | staging | production

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aviationstack
DB_USER=your_user
DB_PASSWORD=your_password

# ─── API keys / external sources ──────────────────────────────────────────────
# AVIATIONSTACK_API_KEY=

# ─── Paths ────────────────────────────────────────────────────────────────────
DATA_RAW_PATH=data/bronze
DATA_PROCESSED_PATH=data/silver
DATA_OUTPUT_PATH=data/gold
LOGS_PATH=logs